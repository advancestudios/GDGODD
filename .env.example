# Copia este archivo como ".env" y rellena los valores. NO subas el ".env" al repositorio.

# Token del bot (Discord Developer Portal > Bot)
DISCORD_TOKEN=
# ID de la aplicación (Developer Portal > General Information)
CLIENT_ID=
# ID del servidor donde se registran los comandos
GUILD_ID=

# (Opcional) IDs de usuario de los dueños del bot, separados por coma. Tienen acceso total a los comandos de staff.
OWNER_IDS=

# (Opcional) Carpeta donde se guarda hardest.json. Por defecto: ./data
# En hosting con disco persistente, por ejemplo en Render: /var/data
DATA_DIR=
